{
  "name": "remote-fs-mcp",
  "version": "0.1.0",
  "description": "Mount-scoped SSH/SFTP filesystem MCP server with configurable read, write and delete permissions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twricu/remote-fs-mcp.git"
  },
  "homepage": "https://github.com/twricu/remote-fs-mcp#readme",
  "bugs": {
    "url": "https://github.com/twricu/remote-fs-mcp/issues"
  },
  "keywords": [
    "mcp",
    "ssh",
    "sftp",
    "filesystem",
    "logs",
    "archives"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "remote-fs-mcp": "src/index.js"
  },
  "files": [
    "src",
    "examples",
    "docs",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/*.test.js",
    "test:stdio": "node --test test/stdio.test.js",
    "lint": "eslint src test scripts eslint.config.js",
    "docs:sync": "node scripts/sync-readme.js",
    "test:package": "node scripts/check-package.js",
    "prepack": "node scripts/sync-readme.js --check",
    "prepublishOnly": "npm test && npm run lint"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "crc-32": "^1.2.2",
    "ssh2": "^1.17.0",
    "tar-stream": "^3.2.2",
    "yaml": "^2.8.1",
    "yauzl": "^3.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "eslint": "^10.13.0",
    "globals": "^16.4.0",
    "yazl": "^3.3.1"
  },
  "license": "MIT"
}
